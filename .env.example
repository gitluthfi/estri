# Copy to .env for local development. In production these are supplied via
# the Kubernetes ConfigMap/Secret (see k8s/configmap.yaml, k8s/secret.yaml).

PORT=8080
ENVIRONMENT=development

# Where the built React SPA (web/dist, from `npm run build`) lives on disk.
# The Go server serves it directly alongside /api — estri is a single binary
# and a single deployable, not separate frontend/backend services.
STATIC_DIR=web/dist

DATABASE_URL=postgres://estri:estri@localhost:5432/estri?sslmode=disable

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=480

# AES key used to encrypt AWS static access/secret keys at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me-to-a-long-random-string

# Session cookie is Secure by default (HTTPS only). Set to false for local
# HTTP development.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Bootstrap admin account, created automatically the first time the server
# starts against an empty database. Ignored afterwards.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@estri.local
ADMIN_PASSWORD=change-me
